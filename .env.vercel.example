# Copy values into Vercel Project Environment Variables; NEVER prefix with VITE_/NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST/DATABASE?sslmode=require
DATABASE_MIGRATION_URL=postgresql://MIGRATOR:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
ADMIN_TOKEN=replace-with-a-long-random-secret
BACKUP_S3_BUCKET=private-preview-backups
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
# Optional S3-compatible provider endpoint; omit for AWS S3.
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_S3_ENCRYPTION=AES256
# Optional second independent private bucket. Completion requires both writes if configured.
# SECONDARY_S3_BUCKET=independent-backups
# SECONDARY_S3_REGION=ap-southeast-1
# SECONDARY_S3_ACCESS_KEY_ID=replace-me
# SECONDARY_S3_SECRET_ACCESS_KEY=replace-me
# SECONDARY_S3_ENDPOINT=https://another-provider.example.com
# SECONDARY_S3_FORCE_PATH_STYLE=true
# Only used by the offline restore tool, never set to a live production DB by default:
# RESTORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/RECOVERY_DATABASE?sslmode=require
